# Copie ce fichier en `.env` et renseigne les valeurs.
# Ne jamais committer `.env` (secrets).

# URL absolue du backend FAUCON (sans préfixe /api — le serveur monte ses
# routes directement sous /auth, /vehicles, /admin...).
# Cette URL est utilisée par le proxy de next.config.ts : le navigateur appelle
# `/api/*` (même origine) et Next.js relaie vers le serveur distant. Cela évite
# tout blocage CORS — c'est pourquoi le mobile natif fonctionne et pas le web.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL du canal temps réel (WebSocket — utilisé par realtime.ts)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
